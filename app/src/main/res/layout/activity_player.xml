<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="true" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/back"
            style="@style/PlayerIcon"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/loop"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/loop_ab"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/subtitle"
            style="@style/PlayerIcon"
            android:contentDescription="@string/add_subtitles"
            android:src="@drawable/ic_subtitles" />

        <ImageButton
            android:id="@+id/lock"
            style="@style/PlayerIcon"
            android:contentDescription="@string/lock_screen"
            android:src="@drawable/ic_lock" />

        <ImageButton
            android:id="@+id/rotate"
            style="@style/PlayerIcon"
            android:contentDescription="@string/rotate"
            android:src="@drawable/ic_rotate" />

        <ImageButton
            android:id="@+id/aspect"
            style="@style/PlayerIcon"
            android:contentDescription="@string/aspect_ratio"
            android:src="@drawable/ic_aspect" />

        <ImageButton
            android:id="@+id/pip"
            style="@style/PlayerIcon"
            android:contentDescription="@string/pip"
            android:src="@drawable/ic_pip" />
    </LinearLayout>

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hud_bg"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/unlock"
        style="@style/PlayerIcon"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="24dp"
        android:background="@drawable/hud_bg"
        android:contentDescription="@string/unlock_screen"
        android:src="@drawable/ic_unlock"
        android:visibility="gone" />
</FrameLayout>
